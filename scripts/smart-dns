#!/usr/bin/env bash
# ==============================================================================
# SMART-DNS CLI MANAGEMENT CONSOLE
# Command: smart-dns
# ==============================================================================

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
NC='\033[0m'

# Check root
if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}[ERROR] Please run with sudo: sudo smart-dns${NC}"
    exit 1
fi

detect_role() {
    if [ -f "/etc/coredns/Corefile" ]; then
        echo "iran"
    elif [ -f "/etc/nginx/nginx.conf" ] && grep -q "stream" /etc/nginx/nginx.conf 2>/dev/null; then
        echo "germany"
    else
        echo "unknown"
    fi
}

ROLE=$(detect_role)

show_header() {
    clear
    echo -e "${CYAN}${BOLD}"
    echo "================================================================================"
    echo "                      SMART-DNS MANAGEMENT CONSOLE                             "
    echo "================================================================================"
    echo -e "${NC}"
    
    if [ "$ROLE" == "iran" ]; then
        echo -e "Server Role:   ${GREEN}${BOLD}Iran Edge Node (DNS + Proxy Forwarder)${NC}"
        LOCAL_IP=$(curl -s4 https://api.ipify.org 2>/dev/null || ip -4 addr show eth0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || echo "Unknown")
        echo -e "Primary DNS:   ${BOLD}${LOCAL_IP}${NC}"
    elif [ "$ROLE" == "germany" ]; then
        echo -e "Server Role:   ${MAGENTA}${BOLD}Germany Egress Gateway (SNI Egress)${NC}"
        LOCAL_IP=$(curl -s4 https://api.ipify.org 2>/dev/null || ip -4 addr show eth0 2>/dev/null | grep -oP '(?<=inet\s)\d+(\.\d+){3}' | head -n1 || echo "Unknown")
        echo -e "Public IP:     ${BOLD}${LOCAL_IP}${NC}"
    else
        echo -e "Server Role:   ${YELLOW}Not Configured${NC}"
    fi
    echo -e "${CYAN}--------------------------------------------------------------------------------${NC}"
}

# ------------------------------------------------------------------------------
# 1. Service Health Status
# ------------------------------------------------------------------------------
check_status() {
    show_header
    echo -e "${BOLD}--- Service Health Status ---${NC}\n"

    if [ "$ROLE" == "iran" ]; then
        # Check CoreDNS
        if systemctl is-active --quiet coredns; then
            echo -e "CoreDNS Service:        ${GREEN}[ACTIVE] (Port 53 UDP/TCP listening)${NC}"
        else
            echo -e "CoreDNS Service:        ${RED}[INACTIVE / FAILED]${NC}"
        fi

        # Check HAProxy
        if systemctl is-active --quiet haproxy; then
            echo -e "HAProxy Forwarder:      ${GREEN}[ACTIVE] (Port 443 TCP listening)${NC}"
        else
            echo -e "HAProxy Forwarder:      ${RED}[INACTIVE / FAILED]${NC}"
        fi

        # Check German upstream latency
        GERMAN_TARGET=$(grep -oP '(?<=server germany )[\d.]+' /etc/haproxy/haproxy.cfg 2>/dev/null || echo "")
        if [ -n "$GERMAN_TARGET" ]; then
            PING_RES=$(ping -c 3 -W 1 "$GERMAN_TARGET" 2>/dev/null | grep -oP 'min/avg/max[^=]*=\s*[\d.]+/(\K[\d.]+)' || echo "Timeout")
            if [ "$PING_RES" != "Timeout" ]; then
                echo -e "Germany Bridge Latency: ${GREEN}${PING_RES} ms${NC} (${GERMAN_TARGET})"
            else
                echo -e "Germany Bridge Latency: ${YELLOW}ICMP Blocked / Connecting via TCP...${NC}"
            fi
        fi

    elif [ "$ROLE" == "germany" ]; then
        # Check Nginx
        if systemctl is-active --quiet nginx; then
            echo -e "Nginx SNI Egress:       ${GREEN}[ACTIVE] (Port 8443 listening)${NC}"
        else
            echo -e "Nginx SNI Egress:       ${RED}[INACTIVE / FAILED]${NC}"
        fi
    fi

    # Resource usage
    echo -e "\n${BOLD}--- Resource Usage ---${NC}"
    echo -e "Memory Usage:           $(free -m | awk 'NR==2{printf "%s/%s MB (%.1f%%)\n", $3, $2, $3*100/$2}')"
    echo -e "CPU Load (1m, 5m):      $(awk '{print $1 ", " $2}' /proc/loadavg)"
    
    echo ""
    read -rp "Press Enter to return to menu..."
}

# ------------------------------------------------------------------------------
# 2. Live Connected IPs & Real-time Clients
# ------------------------------------------------------------------------------
show_clients() {
    show_header
    echo -e "${BOLD}--- Active Connected Clients & IPs ---${NC}\n"

    if [ "$ROLE" == "iran" ]; then
        echo -e "${YELLOW}Active TCP (Gaming HTTPS / SNI) Connections to Port 443:${NC}"
        CONNS=$(ss -tn state established '( sport = :443 )' | awk 'NR>1 {print $4}' | cut -d: -f1 | sort | uniq -c | sort -nr || true)
        
        if [ -z "$CONNS" ]; then
            echo "  No active TCP sessions right now."
        else
            printf "  %-10s %-25s\n" "Count" "Client IP"
            echo "  -------------------------------------"
            echo "$CONNS" | while read -r count ip; do
                printf "  %-10s %-25s\n" "$count" "$ip"
            done
        fi

        echo -e "\n${YELLOW}Recent Unique DNS Query IPs (Last 100 queries):${NC}"
        DNS_IPS=$(journalctl -u coredns -n 200 --no-pager 2>/dev/null | grep -oP '(?<= - )\d+(\.\d+){3}(?=:\d+)' | sort | uniq -c | sort -nr | head -n 15 || true)
        if [ -z "$DNS_IPS" ]; then
            echo "  Waiting for new incoming DNS queries..."
        else
            printf "  %-10s %-25s\n" "Queries" "Client IP"
            echo "  -------------------------------------"
            echo "$DNS_IPS" | while read -r count ip; do
                printf "  %-10s %-25s\n" "$count" "$ip"
            done
        fi
    elif [ "$ROLE" == "germany" ]; then
        echo -e "${YELLOW}Active Connections From Iran Bridge (Port 8443):${NC}"
        ss -tn '( sport = :8443 )' | awk 'NR>1 {print $4}' | cut -d: -f1 | sort | uniq -c | sort -nr || echo "No active connections."
    fi

    echo ""
    read -rp "Press Enter to return to menu..."
}

# ------------------------------------------------------------------------------
# 3. Live Log Streamer
# ------------------------------------------------------------------------------
view_logs() {
    show_header
    echo -e "${BOLD}--- Live Real-time Logs ---${NC}"
    echo "Press Ctrl+C at any time to exit the log stream."
    echo "--------------------------------------------------------------------------------"
    sleep 1

    if [ "$ROLE" == "iran" ]; then
        journalctl -u coredns -u haproxy -f -n 30
    elif [ "$ROLE" == "germany" ]; then
        journalctl -u nginx -f -n 30
    fi
}

# ------------------------------------------------------------------------------
# 4. Add Domain to Interception List (Iran Only)
# ------------------------------------------------------------------------------
add_domain() {
    show_header
    echo -e "${BOLD}--- Add New Domain to SmartDNS ---${NC}\n"
    read -rp "Enter domain to intercept (e.g. steamcommunity.com): " NEW_DOM
    NEW_DOM=$(echo "$NEW_DOM" | tr -d ' ' | tr '[:upper:]' '[:lower:]')

    if [ -z "$NEW_DOM" ]; then
        echo -e "${RED}Invalid domain.${NC}"
        sleep 1
        return
    fi

    CONF="/etc/coredns/gaming_rewrites.conf"
    if grep -q " ${NEW_DOM}$" "$CONF" 2>/dev/null; then
        echo -e "${YELLOW}Domain '${NEW_DOM}' is already in the list!${NC}"
        sleep 2
        return
    fi

    LOCAL_IP=$(grep -oP '(?<=hosts \{[\r\n\s]{1,100})\d+(\.\d+){3}' "$CONF" | head -n1 || echo "127.0.0.1")
    
    # Insert before 'fallthrough'
    sed -i "/fallthrough/i \        ${LOCAL_IP} ${NEW_DOM}" "$CONF"
    
    systemctl restart coredns
    echo -e "\n${GREEN}[+] Domain '${NEW_DOM}' added and CoreDNS reloaded successfully!${NC}"
    sleep 2
}

# ------------------------------------------------------------------------------
# 5. Diagnostic Self-Test
# ------------------------------------------------------------------------------
run_diagnostics() {
    show_header
    echo -e "${BOLD}--- Running Automated Diagnostic Suite ---${NC}\n"

    if [ "$ROLE" == "iran" ]; then
        echo -e "${YELLOW}[1/3] Testing Split-Horizon DNS Resolution...${NC}"
        RES_GAME=$(dig @127.0.0.1 auth.api.sonyentertainmentnetwork.com +short 2>/dev/null || echo "FAILED")
        RES_CLEAN=$(dig @127.0.0.1 google.com +short 2>/dev/null | head -n1 || echo "FAILED")
        
        echo -e "  PSN Auth Domain:    ${GREEN}${RES_GAME}${NC} (Should be your Iran IP)"
        echo -e "  Google Clean Domain: ${GREEN}${RES_CLEAN}${NC} (Should be direct Google IP)"

        echo -e "\n${YELLOW}[2/3] Testing TLS SNI Egress to Germany & Upstream...${NC}"
        HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --resolve adobe.com:443:127.0.0.1 https://adobe.com/ --connect-timeout 5 || echo "FAILED")
        if [ "$HTTP_CODE" == "200" ] || [ "$HTTP_CODE" == "301" ] || [ "$HTTP_CODE" == "302" ]; then
            echo -e "  Adobe Egress Test:  ${GREEN}[PASSED] (HTTP Status: ${HTTP_CODE})${NC}"
        else
            echo -e "  Adobe Egress Test:  ${RED}[FAILED / TIMEOUT]${NC}"
        fi
    elif [ "$ROLE" == "germany" ]; then
        echo -e "${YELLOW}[1/1] Checking Nginx Stream Listener on Port 8443...${NC}"
        if ss -tlpn | grep -q ":8443"; then
            echo -e "  Port 8443: ${GREEN}[LISTENING AND READY]${NC}"
        else
            echo -e "  Port 8443: ${RED}[NOT LISTENING]${NC}"
        fi
    fi

    echo ""
    read -rp "Press Enter to return to menu..."
}

# ------------------------------------------------------------------------------
# 6. Restart All Services
# ------------------------------------------------------------------------------
restart_services() {
    show_header
    echo -e "${YELLOW}[*] Restarting services...${NC}"
    if [ "$ROLE" == "iran" ]; then
        systemctl restart coredns haproxy
        echo -e "${GREEN}[+] CoreDNS and HAProxy restarted!${NC}"
    elif [ "$ROLE" == "germany" ]; then
        systemctl restart nginx
        echo -e "${GREEN}[+] Nginx restarted!${NC}"
    fi
    sleep 2
}

# ------------------------------------------------------------------------------
# 7. Complete Clean Uninstall
# ------------------------------------------------------------------------------
uninstall_all() {
    show_header
    echo -e "${RED}${BOLD}================================================================${NC}"
    echo -e "${RED}${BOLD}                   COMPLETE UNINSTALLATION                      ${NC}"
    echo -e "${RED}${BOLD}================================================================${NC}\n"
    echo -e "This will completely remove all SmartDNS configurations, CoreDNS,"
    echo -e "HAProxy / Nginx stream rules, and restore your system to default."
    echo ""
    read -rp "Are you SURE you want to completely uninstall? (type 'yes' to confirm): " CONFIRM
    if [ "$CONFIRM" != "yes" ]; then
        echo -e "${YELLOW}Aborted.${NC}"
        sleep 1
        return
    fi

    echo -e "\n${YELLOW}[*] Cleaning up services and files...${NC}"

    if [ "$ROLE" == "iran" ]; then
        systemctl stop coredns haproxy rathole-client 2>/dev/null || true
        systemctl disable coredns haproxy rathole-client 2>/dev/null || true
        rm -f /etc/systemd/system/coredns.service /etc/systemd/system/rathole-client.service
        rm -rf /usr/local/bin/coredns /etc/coredns /etc/haproxy /etc/rathole
        apt-get purge -y haproxy 2>/dev/null || yum remove -y haproxy 2>/dev/null || true
        # Re-enable systemd-resolved
        sed -i 's/DNSStubListener=no/#DNSStubListener=yes/' /etc/systemd/resolved.conf 2>/dev/null || true
        systemctl restart systemd-resolved 2>/dev/null || true
    elif [ "$ROLE" == "germany" ]; then
        systemctl stop nginx rathole-server 2>/dev/null || true
        systemctl disable nginx rathole-server 2>/dev/null || true
        rm -f /etc/systemd/system/rathole-server.service
        rm -rf /usr/local/bin/rathole /etc/rathole /etc/nginx
        apt-get purge -y nginx nginx-common libnginx-mod-stream 2>/dev/null || true
    fi

    # Remove sysctl optimization and iptables rules
    rm -f /etc/sysctl.d/99-gaming-proxy.conf
    iptables -t mangle -F 2>/dev/null || true
    rm -f /usr/local/bin/smart-dns

    echo -e "\n${GREEN}[+] SmartDNS has been completely removed from this server!${NC}"
    exit 0
}

# ------------------------------------------------------------------------------
# Main Menu Loop
# ------------------------------------------------------------------------------
while true; do
    show_header
    echo -e "Select an action:\n"
    echo "  1) Check Status & Resource Usage"
    echo "  2) Show Connected Client IPs & Recent Queries"
    echo "  3) View Live Logs (Real-time Stream)"
    if [ "$ROLE" == "iran" ]; then
        echo "  4) Add Domain to Unblock / Interception List"
    else
        echo "  4) [Unavailable on German Node]"
    fi
    echo "  5) Run Diagnostics & End-to-End Self-Test"
    echo "  6) Restart Services"
    echo "  7) Completely Uninstall SmartDNS"
    echo "  0) Exit"
    echo ""
    read -rp "Enter choice [0-7]: " OPTION

    case "$OPTION" in
        1) check_status ;;
        2) show_clients ;;
        3) view_logs ;;
        4) [ "$ROLE" == "iran" ] && add_domain || { echo "Only available on Iran node."; sleep 1; } ;;
        5) run_diagnostics ;;
        6) restart_services ;;
        7) uninstall_all ;;
        0) clear; exit 0 ;;
        *) echo -e "${RED}Invalid option.${NC}"; sleep 1 ;;
    esac
done
